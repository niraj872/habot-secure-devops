{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transactional Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "payload",
    "published_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
