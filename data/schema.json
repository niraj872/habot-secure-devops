{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Student Onboarding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_id",
    "student_name",
    "age",
    "has_learning_difficulty",
    "requires_learning_support",
    "consent_given",
    "data_region"
  ],
  "properties": {
    "student_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "student_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "age": {
      "type": "integer",
      "minimum": 3,
      "maximum": 25
    },
    "has_learning_difficulty": {
      "type": "boolean"
    },
    "requires_learning_support": {
      "type": "boolean"
    },
    "consent_given": {
      "type": "boolean"
    },
    "data_region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    }
  }
}
